{
	# Certificates for custom domains are issued only for names the API says are verified (404 while custom domains are off).
	on_demand_tls {
		ask http://api:8080/api/domains/allowed
	}
}

(web) {
	reverse_proxy web:3000 {
		header_up X-Forwarded-For {http.request.remote.host}
		header_up -Forwarded
		header_up -X-Real-IP
	}
}

{$SITE_ADDRESS} {
	import web
}

# Verified custom domains.
https:// {
	tls {
		on_demand
	}
	import web
}
