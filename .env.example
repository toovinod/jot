# Copy to .env at repository root. Bun loads this for root workspace commands.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
# Empty by default. Never trust forwarded headers from arbitrary clients.
TRUSTED_PROXY_CIDRS=
API_ADDR=:8080
API_INTERNAL_URL=http://127.0.0.1:8080
DATABASE_URL=postgres://jot:jot@localhost:5433/jot?sslmode=disable
# Optional direct connection for migrations. Neon CLI fills this automatically.
DATABASE_URL_UNPOOLED=
# Test database must be isolated; integration tests create/modify records.
JOT_TEST_DATABASE_URL=
# Optional AI: only explicit author requests enqueue text for this provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Verify your sending domain in Resend before enabling subscriptions.
RESEND_API_KEY=
EMAIL_FROM=Jot <posts@example.com>
# Paths resolve from apps/api when using root Bun scripts; persist this volume.
UPLOAD_DIR=../../.data/uploads
# Set S3_BUCKET=jot with Neon Object Storage. Neon CLI supplies the AWS_* values.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_* overrides configure another S3 provider or a custom public media URL.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Compose-only: replace before running a shared deployment.
POSTGRES_PASSWORD=jot
POSTGRES_ADMIN_PASSWORD=jot-admin-development
POSTGRES_PORT=5433
WEB_PORT=3000

# Compose uses its private Postgres URL unless this is explicitly set (for example Neon).
COMPOSE_DATABASE_URL=
COMPOSE_DATABASE_URL_UNPOOLED=
JOT_SUBNET=172.31.97.0/24
JOT_WEB_IP=172.31.97.254
# Required only with compose.production.yaml: public DNS hostname, no scheme/path.
SITE_ADDRESS=
# HTTP seed needs a running API. Password is deliberately never supplied by default.
SEED_BASE_URL=http://127.0.0.1:8080
SEED_EMAIL=demo@example.com
SEED_USERNAME=demo
SEED_PASSWORD=
