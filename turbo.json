{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".env", ".env.*"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "PGPASSWORD",
    "APP_ORIGIN",
    "CUSTOM_DOMAIN_TARGET",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_ENDPOINT_URL_S3",
    "AWS_REGION",
    "UPLOAD_DIR",
    "GOCACHE",
    "GOMODCACHE",
    "GOPATH",
    "CGO_ENABLED",
    "JOT_TEST_DATABASE_URL",
    "PORT",
    "CI",
    "NEXT_TELEMETRY_DISABLED",
    "API_ADDR",
    "S3_PUBLIC_URL",
    "SEED_PASSWORD",
    "SEED_EMAIL",
    "SEED_USERNAME",
    "GOTOOLCHAIN",
    "APP_ENV",
    "TRUSTED_PROXY_CIDRS",
    "VIEW_HASH_SECRET"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "bin/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    }
  },
  "ui": "tui",
  "globalEnv": ["API_INTERNAL_URL"]
}
